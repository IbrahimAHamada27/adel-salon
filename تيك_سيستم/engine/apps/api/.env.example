# ===================================================
# TECH POS API - ENVIRONMENT TEMPLATE
# ===================================================
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# In production: must be min 32 chars and not use default words
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=7d

DATABASE_FILE=./data/tech_server.sqlite

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_TTL_SECONDS=300
RATE_LIMIT_SYNC_MAX=60
