# ===================================================
# TECH POS SYSTEM - ROOT ENVIRONMENT TEMPLATE
# ===================================================
# DO NOT COMMIT ACTUAL SENSITIVE VALUES TO VERSION CONTROL

# Node Environment (development | production | test)
NODE_ENV=development

# Backend API Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Security & JWT Configuration
# In production, JWT_SECRET MUST be a cryptographically random string (min 32 characters)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Database Configuration
DATABASE_FILE=./data/tech_server.sqlite

# Rate Limiting Settings
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_TTL_SECONDS=300
RATE_LIMIT_SYNC_MAX=60

# Frontend Next.js API URL
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
